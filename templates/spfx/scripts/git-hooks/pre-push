#!/bin/sh
# Blocks pushes to main/master from any tool (Copilot, terminal, IDE).
# Installed into .git/hooks by scripts/install-git-hooks.ps1.
while read local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      echo "pre-push: pushing to ${remote_ref#refs/heads/} is blocked. Push a branch and open a PR in Bitbucket." >&2
      exit 1
      ;;
  esac
done
exit 0
